{
  "manifest_version": 3,
  "name": "区位笔记 · 高德标注",
  "version": "0.1.3",
  "description": "个人区位图标注：点线面、分类、照片、本地项目与 CSV 双向导入导出。",
  "minimum_chrome_version": "111",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "action": {
    "default_title": "区位笔记",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.amap.com/*",
        "https://amap.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.amap.com/*",
        "https://amap.com/*"
      ],
      "js": [
        "core.js",
        "editor.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "panel.html",
        "panel.css",
        "panel.js",
        "core.js",
        "store.js",
        "sync.js"
      ],
      "matches": [
        "https://www.amap.com/*",
        "https://amap.com/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'; img-src 'self' data: blob:; style-src 'self'"
  }
}
